{
  "name": "huddle-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-independent AI voice Huddles extracted from Buzz 1.0.4",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-audio": {
      "types": "./dist/web-audio/index.d.ts",
      "import": "./dist/web-audio/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "import": "./dist/relay/index.js"
    },
    "./webcodecs": {
      "types": "./dist/webcodecs/index.d.ts",
      "import": "./dist/webcodecs/index.js"
    },
    "./agent-voice": {
      "types": "./dist/agent-voice/index.d.ts",
      "import": "./dist/agent-voice/index.js"
    },
    "./codex-voice": {
      "types": "./dist/codex-voice/index.d.ts",
      "import": "./dist/codex-voice/index.js"
    },
    "./claude-voice": {
      "types": "./dist/claude-voice/index.d.ts",
      "import": "./dist/claude-voice/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run demo:ai",
    "demo:agent": "npm run build && node scripts/demo-agent.mjs",
    "demo:core": "npm run build && node examples/controller.mjs",
    "demo:audio": "npm run build && node scripts/serve-demo.mjs",
    "demo:relay": "npm run build && node scripts/demo-relay.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "prepack": "npm run build",
    "demo:codex": "npm run build && node scripts/demo-codex.mjs",
    "setup:claude": "node scripts/setup-claude-voice.mjs",
    "demo:claude": "npm run build && node scripts/demo-claude.mjs",
    "verify:claude-speech": "node scripts/verify-claude-speech.mjs",
    "demo:ai": "npm run build && node scripts/demo-ai.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "ws": "8.23.0"
  }
}
