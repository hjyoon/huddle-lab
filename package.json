{
  "name": "huddle-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Host-independent Huddle lifecycle and call controller extracted from Buzz 1.0.4",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "examples", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node examples/controller.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
